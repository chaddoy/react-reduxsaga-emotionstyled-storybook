                <mxCell id="17" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;General Requirement&lt;/h1&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Should be able to&lt;/li&gt;&lt;ul&gt;&lt;li&gt;display Title and description at the same time&lt;/li&gt;&lt;li&gt;hide description if not available&lt;/li&gt;&lt;li&gt;highlight the first item of the search&lt;/li&gt;&lt;li&gt;select the first seached item when enter is pressed&lt;/li&gt;&lt;li&gt;display no results found&lt;/li&gt;&lt;li&gt;foucs the seach input once the dropdown is displayed&lt;/li&gt;&lt;li&gt;scroll through the dropdown&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;h1 style=&quot;color: rgb(0, 0, 0); scrollbar-color: light-dark(#e2e2e2, #4b4b4b)&lt;br/&gt;&#x9;&#x9;&#x9;&#x9;&#x9;light-dark(#fbfbfb, var(--dark-panel-color)); margin-top: 0px;&quot;&gt;Functional Requirement&lt;/h1&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Responsiveness&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;h1 style=&quot;color: rgb(0, 0, 0); scrollbar-color: light-dark(#e2e2e2, #4b4b4b)&lt;br/&gt;&#x9;&#x9;&#x9;&#x9;&#x9;light-dark(#fbfbfb, var(--dark-panel-color)); margin-top: 0px;&quot;&gt;Data Entities&lt;/h1&gt;&lt;/div&gt;&lt;div&gt;type Board = {&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;id: number&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;name: string&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;description: string&lt;br&gt;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); scrollbar-color: light-dark(#e2e2e2, #4b4b4b)&lt;br/&gt;&#x9;&#x9;&#x9;&#x9;&#x9;light-dark(#fbfbfb, var(--dark-panel-color));&quot;&gt;&lt;h1 style=&quot;color: rgb(0, 0, 0); scrollbar-color: light-dark(#e2e2e2, #4b4b4b)&lt;br/&gt;&#x9;&#x9;&#x9;&#x9;&#x9;light-dark(#fbfbfb, var(--dark-panel